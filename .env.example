NODE_ENV=development
PORT=3000

# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/shopify_order_crm"

FRONTEND_URL="http://localhost:5173"

# First CRM login, created on startup if it doesn't exist yet
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-strong-password"

# Long random secret used to sign login tokens
JWT_SECRET="replace-with-a-long-random-secret"

# 32-byte key (64 hex characters) used to encrypt the Shopify access token at rest
TOKEN_ENCRYPTION_KEY="replace-with-64-hex-characters"

# Shopify app credentials (server side only)
SHOPIFY_API_KEY="your-shopify-api-key"
SHOPIFY_API_SECRET="your-shopify-api-secret"
SHOPIFY_SCOPES="read_orders,read_all_orders,write_orders,read_customers,read_products"
SHOPIFY_API_VERSION="2026-01"
SHOPIFY_APP_URL="http://localhost:3000"
