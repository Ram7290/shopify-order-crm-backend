NODE_ENV=development
PORT=3000

# PostgreSQL connection string (Neon: append ?sslmode=require)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/shopify_order_crm"

# Frontend origin allowed by CORS and used for the post-install redirect
FRONTEND_URL="http://localhost:5173"

# First CRM login, created on startup if it doesn't exist yet
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-strong-password"

# Long random secret used to sign login tokens
JWT_SECRET="replace-with-a-long-random-secret"

# 32-byte key (64 hex characters) used to encrypt Shopify tokens at rest
TOKEN_ENCRYPTION_KEY="replace-with-64-hex-characters"

# Shopify app credentials (server side only, never commit)
SHOPIFY_API_KEY="your-client-id"
SHOPIFY_API_SECRET="your-client-secret"
SHOPIFY_SCOPES="read_orders,write_orders,write_draft_orders,read_customers,read_products"
SHOPIFY_API_VERSION="2026-10"

# Public HTTPS base URL of this backend (used for OAuth redirect and webhook delivery)
SHOPIFY_APP_URL="http://localhost:3000"
